<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CV History - PassAI</title>
    <link rel="stylesheet" href="resume-generator.css">
    <link rel="stylesheet" href="ui-improvements.css">
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <div class="header-content">
                <div>
                    <h1>📄 CV History</h1>
                    <p class="subtitle">Manage and preview all your generated resumes</p>
                </div>
                <button id="btn-profile" class="btn btn-secondary" onclick="openProfileChat()">
                    👤 Gerenciar Perfil
                </button>
            </div>
        </div>

        <!-- 2-Column Layout -->
        <div class="two-column-layout">
            <!-- Left Sidebar: Job List -->
            <div class="sidebar">
                <div class="sidebar-header">
                    <h3>Jobs with CVs</h3>
                    <span id="jobs-count" class="badge">0</span>
                </div>
                
                <div id="job-list" class="job-list">
                    <!-- Jobs will be loaded here -->
                    <div class="empty-state">
                        <p>📭 No CVs generated yet</p>
                        <p class="hint">Generate your first CV from the Jobs window</p>
                    </div>
                </div>
            </div>

            <!-- Right Panel: Variants Display -->
            <div class="main-panel">
                <!-- When no job selected -->
                <div id="no-selection" class="empty-state-main">
                    <div class="empty-icon">📋</div>
                    <h2>Select a job to view resumes</h2>
                    <p>Click on a job from the left sidebar to see all generated variants</p>
                </div>

                <!-- When job is selected -->
                <div id="variants-panel" class="hidden">
                    <!-- Panel Header -->
                    <div class="panel-header">
                        <div class="job-info">
                            <h2 id="selected-job-title">Job Title</h2>
                            <p id="selected-job-company">Company</p>
                        </div>
                        <div class="job-stats">
                            <span id="variants-count-badge" class="stat-badge">0 variants</span>
                            <span id="best-score-badge" class="stat-badge score">Best: 0</span>
                        </div>
                    </div>

                    <!-- Generate More Button -->
                    <div class="action-bar">
                        <button id="btn-generate-more" class="btn btn-primary">
                            🔄 Generate +3 More Variants
                        </button>
                        <span id="generate-status" class="generate-status hidden"></span>
                    </div>

                    <!-- Variants Grid -->
                    <div id="variants-grid" class="variants-grid">
                        <!-- Variant cards will be loaded here -->
                    </div>
                </div>

                <!-- Generation Progress (shown when generating more) -->
                <div id="generation-progress" class="hidden">
                    <div class="progress-container">
                        <h3>Generating additional variants...</h3>
                        <div class="progress-stats">
                            <div class="stat">
                                <span class="stat-label">Variants</span>
                                <span class="stat-value" id="gen-progress-variants">0</span>
                            </div>
                            <div class="stat">
                                <span class="stat-label">Best Score</span>
                                <span class="stat-value" id="gen-progress-score">-</span>
                            </div>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill" id="gen-progress-fill"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Preview Modal -->
    <div id="preview-modal" class="modal hidden">
        <div class="modal-overlay" onclick="closePreviewModal()"></div>
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modal-title">Variant Preview</h2>
                <button class="modal-close" onclick="closePreviewModal()">✕</button>
            </div>
            <div class="modal-body" id="modal-body">
                <!-- Variant content will be loaded here -->
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closePreviewModal()">Close</button>
                <button id="modal-download-btn" class="btn btn-primary">
                    💾 Download
                </button>
            </div>
        </div>
    </div>

    <script>
        // Function to open profile chat in new window
        function openProfileChat() {
            const chatWindow = window.open(
                '../profile-chat/profile-chat.html',
                'ProfileChat',
                'width=700,height=800,resizable=yes,scrollbars=yes'
            );
            
            if (!chatWindow) {
                alert('Por favor, permita pop-ups para abrir o chat de perfil!');
            }
        }

        function closePreviewModal() {
            document.getElementById('preview-modal').classList.add('hidden');
        }
    </script>
    
    <script src="resume-generator.js"></script>
    <script src="ui-improvements.js"></script>
</body>
</html>
